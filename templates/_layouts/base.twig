<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ entry.title ?? siteName }}{% endblock %}</title>

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/styles.css">

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Meta Tags -->

    <style>[x-cloak] { display: none !important; }</style>
    {% block head %}{% endblock %}
</head>
<body class="bg-gray-950 text-gray-100 antialiased">
    {% block header %}
        {% include "_partials/header.twig" %}
    {% endblock %}

    <!-- Main Content -->
    <main class="min-h-screen">
        {% block content %}{% endblock %}
    </main>

    {% block footer %}
    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-300 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="text-center">
                <p>&copy; {{ "now"|date('Y') }} {{ siteName }}. All rights reserved.</p>
                <p class="mt-2">
                    <a href="/privacy" class="text-blue-400 hover:text-blue-300 transition-colors">Privacy Policy</a>
                </p>
            </div>
        </div>
    </footer>
    {% endblock %}

    {% block scripts %}{% endblock %}
</body>
</html>
