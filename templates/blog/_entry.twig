{% extends "_layouts/base.twig" %}

{% block title %}{{ entry.title }} - {{ parent() }}{% endblock %}

{% block content %}
{% set blogImage = entry.blogImage.one() %}
{% set posts = craft.entries().section('blog').type('blogPost').orderBy('postDate ASC') %}
{% set previousPost = entry.getPrev(posts) %}
{% set nextPost = entry.getNext(posts) %}

<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-8">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-emerald-400">
            <time datetime="{{ entry.postDate|atom }}">{{ entry.postDate|date('F j, Y') }}</time>
        </p>
        <h1 class="text-4xl font-bold text-gray-100 sm:text-5xl">{{ entry.title }}</h1>
    </header>

    {% if blogImage %}
        <img src="{{ blogImage.url }}" alt="{{ blogImage.title ?: entry.title }}" class="mb-10 aspect-video w-full rounded-lg object-cover" width="1200" height="675">
    {% endif %}

    {% if entry.body|length %}
        <div class="prose prose-lg prose-invert max-w-none prose-a:text-emerald-400">
            {{ entry.body }}
        </div>
    {% endif %}

    {% if previousPost or nextPost %}
        <nav aria-label="Blog post navigation" class="mt-12 grid grid-cols-2 gap-6 border-t border-gray-800 pt-8">
            <div>
                {% if previousPost %}
                    <a href="{{ previousPost.url }}" rel="prev" class="group block">
                        <span class="text-sm font-semibold text-emerald-400 transition-colors group-hover:text-emerald-300">&larr; Previous post</span>
                        <span class="mt-1 block font-bold text-gray-100">{{ previousPost.title }}</span>
                    </a>
                {% endif %}
            </div>

            <div class="text-right">
                {% if nextPost %}
                    <a href="{{ nextPost.url }}" rel="next" class="group block">
                        <span class="text-sm font-semibold text-emerald-400 transition-colors group-hover:text-emerald-300">Next post &rarr;</span>
                        <span class="mt-1 block font-bold text-gray-100">{{ nextPost.title }}</span>
                    </a>
                {% endif %}
            </div>
        </nav>
    {% endif %}
</article>
{% endblock %}
