{% extends "_layouts/base.twig" %}

{% block title %}Blog - {{ parent() }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="mb-10 text-4xl font-bold text-gray-100">New &amp; Exciting</h1>

    {% set posts = craft.entries()
        .section('blog')
        .type('blogPost')
        .orderBy('postDate DESC')
        .with(['blogImage'])
        .all() %}

    {% if posts|length %}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {% for post in posts %}
                {% set blogImage = post.blogImage.one() %}

                <article class="overflow-hidden rounded-lg border border-gray-800 bg-gray-900 shadow-lg">
                    <a href="{{ post.url }}" class="block">
                        {% if blogImage %}
                            <img src="{{ blogImage.url }}" alt="{{ blogImage.title ?: post.title }}" class="aspect-video w-full object-cover" width="640" height="360" loading="lazy">
                        {% else %}
                            <div class="aspect-video bg-gray-800"></div>
                        {% endif %}
                    </a>

                    <div class="p-6">
                        <time datetime="{{ post.postDate|atom }}" class="text-sm text-gray-400">{{ post.postDate|date('F j, Y') }}</time>
                        <h2 class="mt-2 text-2xl font-bold text-gray-100">
                            <a href="{{ post.url }}" class="transition-colors hover:text-emerald-400">{{ post.title }}</a>
                        </h2>

                        {% if post.body|length %}
                            <p class="mt-3 text-gray-400">{{ post.body|striptags|truncate(160) }}</p>
                        {% endif %}

                        <a href="{{ post.url }}" class="mt-5 inline-flex font-semibold text-emerald-400 transition-colors hover:text-emerald-300">Read more &rarr;</a>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p class="text-gray-400">No blog posts have been published yet.</p>
    {% endif %}
</div>
{% endblock %}
