{% extends "_layouts/base.twig" %}

{% set title = "Business Signup - FREE" %}

{% block content %}
<div class="xs:max-w-none sm:max-w-5xl md:max-w-5xl lg:max-w-6xl xl:max-w-6xl mx-auto mt-8 mb-16 px-2 md:px-4">
	<div class="bg-gray-900 rounded-lg shadow-md p-2 md:p-8 border border-gray-800">
		<div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6 md:p-10 mb-10 text-gray-200 text-base md:text-lg lg:text-xl leading-loose">
			<h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green-400 mb-6">Business Signup</h1>
			<p class="mb-6 leading-8 text-lg">Join Gifts Around and share your monthly specials with local customers.</p>

			<div class="mb-8 rounded-lg border border-green-500/30 bg-green-500/10 p-5">
				<p class="text-sm font-semibold uppercase tracking-wide text-green-300">Free For Businesses</p>
				<p class="mt-2 text-3xl font-bold text-gray-100">$0 <span class="text-base font-medium text-gray-300">/ month</span></p>
			</div>

			<h2 class="text-base md:text-lg font-semibold text-green-400 mb-4">How it works</h2>
			<ol class="grid gap-3 text-base md:grid-cols-3 md:text-lg">
				<li class="rounded-lg border border-gray-700 bg-gray-900/60 p-4">
					<span class="block text-sm font-semibold uppercase tracking-wide text-blue-300">Step 1</span>
					Tell us about your business.
				</li>
				<li class="rounded-lg border border-gray-700 bg-gray-900/60 p-4">
					<span class="block text-sm font-semibold uppercase tracking-wide text-blue-300">Step 2</span>
					Share your monthly special.
				</li>
				<li class="rounded-lg border border-gray-700 bg-gray-900/60 p-4">
					<span class="block text-sm font-semibold uppercase tracking-wide text-blue-300">Step 3</span>
					Reach local customers.
				</li>
			</ol>
		</div>

		{% set form = craft.freeform.form('businessSignUp') %}

		{% if form %}
			{{ form.render({
				formattingTemplate: 'tailwind-3',
				attributes: {
					form: { class: 'freeform-form' },
					row: { class: 'mb-5' },
					container: { class: 'space-y-5' }
				},
				buttons: {
					attributes: {
						container: { class: 'pt-2' },
						submit: { class: 'w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 focus:ring-offset-gray-900 transition-colors font-medium text-lg border-0' },
						back: { class: 'px-4 py-2 rounded-md bg-gray-800 text-gray-200 hover:bg-gray-700' },
						save: { class: 'px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700' }
					}
				},
				fields: {
					'@global': {
						attributes: {
							label: { class: 'block text-sm font-medium text-gray-200 mb-2' },
							input: { class: 'w-full px-3 py-2 border border-gray-700 bg-gray-800 rounded-lg text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent' },
							instructions: { class: 'text-sm text-gray-400 mt-1' },
							error: { class: 'text-sm text-red-400 mt-1' }
						}
					},
					'@file': {
						attributes: {
							input: { class: 'w-full text-sm text-gray-300 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border file:border-gray-600 file:bg-gray-800 file:text-gray-200 hover:file:bg-gray-700' }
						}
					},
					'@checkbox': {
						attributes: {
							input: { class: 'h-4 w-4 text-blue-600 bg-gray-800 border-gray-500 rounded focus:ring-blue-500' },
							label: { class: 'text-sm text-gray-300' }
						}
					}
				}
			}) }}
		{% else %}
			<div class="bg-yellow-900/30 border border-yellow-700 rounded-lg p-4">
				<p class="text-yellow-100">The business signup form is currently unavailable. Please try again later or contact support.</p>
			</div>
		{% endif %}

		<div class="mt-6 text-center">
			<p class="text-gray-400">
				Looking for a personal account instead?
				<a href="/register" class="text-blue-400 hover:text-blue-300 font-medium">Sign up as a customer</a>
			</p>
		</div>
	</div>
</div>
{% endblock %}
