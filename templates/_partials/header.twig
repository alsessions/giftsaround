<!-- Header -->
<header class="relative border-b border-white/10 bg-[#050d1a]/95">
    <div class="max-w-none mx-auto px-5 sm:px-7 md:px-10 lg:px-16">
        <div class="flex h-16 items-center justify-between md:h-20 lg:h-24">
            <div class="flex items-center">
                <a href="/" class="flex items-center group">
                    <img src="/uploads/business/trans_logo.png" alt="Gifts Around" class="h-11 w-auto transition-transform duration-200 group-hover:scale-105 md:h-14 lg:h-[4.5rem]">
                </a>
            </div>

            <!-- Navigation -->
            <nav class="hidden items-center gap-12 text-lg font-semibold text-white lg:flex">
                <a href="/business" class="transition-colors hover:text-emerald-300">Browse Deals</a>
                <a href="/#categories" class="transition-colors hover:text-emerald-300">Categories</a>
                <a href="/business" class="transition-colors hover:text-emerald-300">Businesses</a>
                <div class="relative" x-data="{ open: false }" @click.away="open = false">
                    <button @click="open = !open; if (open) { $nextTick(() => $refs.desktopSearch.focus()) }" class="flex h-12 w-12 items-center justify-center rounded-md text-white/90 transition-colors hover:bg-white/5 hover:text-white" type="button" aria-label="Search">
                        <svg class="h-5 w-5 lg:h-6 lg:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>

                    <div x-show="open"
                         x-cloak
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 scale-95"
                         x-transition:enter-end="opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-150"
                         x-transition:leave-start="opacity-100 scale-100"
                         x-transition:leave-end="opacity-0 scale-95"
                         class="absolute right-0 top-full z-50 mt-3 w-96 rounded-md border border-white/10 bg-[#071321] p-3 shadow-2xl shadow-black/40">
                        <form action="/search" method="get" class="flex items-center gap-2">
                            <input x-ref="desktopSearch" type="text" name="q" placeholder="Search businesses..." class="h-12 min-w-0 flex-1 rounded-md border border-white/10 bg-[#050d1a] px-4 text-base text-white placeholder:text-white/45 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/35">
                            <button type="submit" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md border border-white/10 bg-white/5 text-white transition-colors hover:border-emerald-300/50 hover:bg-white/10" aria-label="Submit search">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </nav>

            <div class="hidden items-center gap-5 lg:flex">
                {% if currentUser %}
                    <a href="/account" class="rounded-md bg-emerald-500 px-9 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-500/20 transition-colors hover:bg-emerald-400">My Account</a>
                    <a href="/logout" class="rounded-md border border-white/25 px-9 py-3.5 text-base font-semibold text-white transition-colors hover:border-white/50 hover:bg-white/5">Sign Out</a>
                {% else %}
                    <a href="/register" class="rounded-md bg-emerald-500 px-9 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-500/20 transition-colors hover:bg-emerald-400">Join Now</a>
                    <a href="/login" class="rounded-md border border-white/25 px-9 py-3.5 text-base font-semibold text-white transition-colors hover:border-white/50 hover:bg-white/5">Login</a>
                {% endif %}
            </div>

            <!-- Mobile menu button -->
            <div class="lg:hidden" x-data="{ open: false }" @click.away="open = false">
                <button @click="open = !open" class="text-blue-400 hover:text-blue-300 focus:outline-none focus:text-blue-300">
                    <svg class="h-6 w-6 md:h-8 md:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path x-show="!open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        <path x-show="open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Mobile menu -->
                <div x-show="open" x-transition class="absolute top-14 right-4 bg-gray-800 rounded-lg shadow-xl py-3 w-64 z-50 border border-gray-700 md:top-20 md:w-72">
                    <!-- Mobile Search -->
                    <div class="px-4 py-2">
                        <form action="/search" method="get" class="relative">
                            <input type="text" name="q" placeholder="Search..." class="w-full px-4 py-2.5 pr-10 bg-gray-900 text-gray-100 text-base border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-blue-400 hover:text-blue-300">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </button>
                        </form>
                    </div>

                    <!-- Mobile Businesses Dropdown -->
                    <div>
                        <button @click.stop="$refs.mobileBusinessMenu.classList.toggle('hidden')" class="w-full text-left px-4 py-2.5 text-base font-semibold text-blue-400 hover:bg-gray-700 flex items-center justify-between">
                            Businesses
                            <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <div x-ref="mobileBusinessMenu" class="bg-gradient-to-b from-gray-900 to-gray-800 hidden">
                            <a href="/business" @click="open = false" class="block px-6 py-2 text-base font-semibold text-gray-300 hover:bg-gray-700 hover:text-blue-400">All Businesses</a>
                            <a href="/category/food-beverage" @click="open = false" class="block px-6 py-2 text-base font-semibold text-gray-300 hover:bg-gray-700 hover:text-blue-400">Food & Beverage</a>
                            <a href="/category/retail" @click="open = false" class="block px-6 py-2 text-base font-semibold text-gray-300 hover:bg-gray-700 hover:text-blue-400">Retail</a>
                            <a href="/category/entertainment" @click="open = false" class="block px-6 py-2 text-base font-semibold text-gray-300 hover:bg-gray-700 hover:text-blue-400">Entertainment</a>
                            <a href="/category/health-beauty" @click="open = false" class="block px-6 py-2 text-base font-semibold text-gray-300 hover:bg-gray-700 hover:text-blue-400">Health & Beauty</a>
                            <a href="/category/services" @click="open = false" class="block px-6 py-2 text-base font-semibold text-gray-300 hover:bg-gray-700 hover:text-blue-400">Services</a>
                        </div>
                    </div>

                    <a href="/contact" @click="open = false" class="block px-4 py-2.5 text-base font-semibold text-blue-400 hover:bg-gray-700">Contact</a>

                    {% if currentUser %}
                        <hr class="my-1.5 border-gray-700">
                        <a href="/account" @click="open = false" class="block px-4 py-2.5 text-base font-semibold text-blue-400 hover:bg-gray-700">My Account</a>
                        <a href="/logout" @click="open = false" class="block px-4 py-2.5 text-base font-semibold text-red-400 hover:bg-red-900/20">Sign Out</a>
                    {% else %}
                        <hr class="my-1.5 border-gray-700">
                        <a href="/login" @click="open = false" class="block px-4 py-2.5 text-base font-semibold text-blue-400 hover:bg-gray-700">Sign In</a>
                        <a href="/register" @click="open = false" class="block px-4 py-2.5 text-base font-semibold text-green-400 hover:bg-green-900/20">Sign Up</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</header>
