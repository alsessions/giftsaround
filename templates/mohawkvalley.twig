{% extends "_layouts/base.twig" %}



{% block content %}
<div class="xs:max-w-none sm:max-w-5xl md:max-w-5xl lg:max-w-6xl xl:max-w-6xl mx-auto mt-8 mb-16 px-2 md:px-4">
    <div class="bg-gray-900 rounded-lg shadow-lg p-2 md:p-8 border border-gray-800">
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-green-400 mb-6">Mohawk Valley Living</h1>

        <div class="mb-6 rounded-lg border border-green-500/30 bg-green-500/10 p-6">
            <p class="text-2xl md:text-3xl font-bold text-gray-100">Many thanks to all of our Mohawk Valley Living readers!</p>
            <p class="mt-4 text-lg leading-8 text-gray-300">
                We're proud to partner with Mohawk Valley Living to help readers discover local deals, support neighborhood businesses, and save throughout the year with a Gifts Around membership.
            </p>
        </div>





        </div>
        <div class="mt-6 bg-gray-900 border border-gray-700 rounded-lg p-6">
            {{ freeform.form('userRegistration').render({
                formattingTemplate: 'user-registration.twig',
            }) }}
        </div>
    </div>
</div>
{% endblock %}
