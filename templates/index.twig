{% extends "_layouts/base.twig" %}

{% block title %}Welcome - {{ parent() }}{% endblock %}

{% block content %}
{% set latestBusinesses = craft.entries()
    .section('business')
    .orderBy('postDate DESC')
    .limit(20)
    .all() %}

{% set categories = [
    { title: 'Health', fullTitle: 'Health & Beauty', url: '/category/health-beauty', icon: 'heart' },
    { title: 'Retail', fullTitle: 'Retail', url: '/category/retail', icon: 'retail' },
    { title: 'Entertainment', fullTitle: 'Entertainment', url: '/category/entertainment', icon: 'ticket' },
    { title: 'Services', fullTitle: 'Services', url: '/category/services', icon: 'gear' },
    { title: 'Food', fullTitle: 'Food & Beverage', url: '/category/food-beverage', icon: 'food' },
    { title: 'Automotive', fullTitle: 'Automotive', url: '/category/automotive', icon: 'car' },
] %}

<div class="min-h-screen bg-[#06101d] text-white">
    <div class="flex w-full flex-col overflow-hidden bg-[#06101d]">
        <section class="relative overflow-hidden border-b border-white/10 bg-[#071321] md:min-h-[500px] lg:min-h-[540px]">
            <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/uploads/_576x381_crop_center-center_82_line/unsplash-hero-glasss.jpg');"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[#071321] via-[#071321]/82 to-[#071321]/20"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#071321]/75 via-transparent to-[#071321]/10"></div>

            <div class="relative mx-auto grid w-full max-w-[90rem] gap-9 px-5 py-12 sm:px-7 sm:py-16 lg:grid-cols-[1fr_0.95fr] lg:px-8 lg:py-20">
                <div class="max-w-xl">
                    <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.16em] text-emerald-400">A full year of local deals for $9.99</p>
                    <h1 class="text-[2rem] font-extrabold leading-[1.12] tracking-normal text-white sm:text-5xl lg:text-[3.35rem]">
                        One local deal could pay for your whole year.
                    </h1>
                    <p class="mt-6 max-w-xl text-lg font-semibold leading-8 text-white lg:text-xl lg:leading-9 mb-4 md:mb-10">
                        Unlock member-only monthly savings at 100+ local businesses.</p>
                                            <p class="mt-6 max-w-xl text-lg font-semibold leading-8 text-white lg:text-xl lg:leading-9 mb-10">Join for just $9.99/year, then keep saving all year.
                    </p>

                    <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:max-w-[540px]">
                        {% if currentUser %}
                            <a href="/account" class="inline-flex h-14 items-center justify-center rounded-md bg-emerald-500 px-7 text-base font-semibold text-white shadow-lg shadow-emerald-500/20 transition-colors hover:bg-emerald-400">
                                My Account
                                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </a>
                        {% else %}
                            <a href="/register" class="inline-flex h-14 items-center justify-center rounded-md bg-emerald-500 px-7 text-base font-semibold text-white shadow-lg shadow-emerald-500/20 transition-colors hover:bg-emerald-400">
                                Join for $9.99/year
                                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </a>
                        {% endif %}
                        <a href="/business" class="inline-flex h-14 items-center justify-center rounded-md border border-white/50 px-7 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/5">See This Month’s Deals</a>
                    </div>
                </div>

                <div class="hidden items-center justify-end pr-5 lg:flex">
                    <div class="flex h-48 w-48 -translate-x-5 translate-y-[52px] rotate-[-10deg] items-center justify-center rounded-full border-4 border-emerald-400 bg-[#0b1726]/90 p-5 text-center shadow-2xl shadow-black/40">
                        <div class="rotate-[10deg]">
                            <p class="whitespace-nowrap text-sm font-extrabold uppercase tracking-[0.16em] text-emerald-300">Support Local</p>
                            <svg class="mx-auto my-4 h-16 w-16 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
                            </svg>
                            <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-emerald-300">Save Big</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class=" bg-[#081522] px-5 py-4 sm:px-7 lg:py-5" id="featured-deals">
            <div class="mx-auto w-full max-w-[90rem]">
            <div class="mb-3 flex items-center justify-between">
                <h2 class="flex items-center text-base font-extrabold text-white lg:text-lg">
                    <svg class="mr-2 h-5 w-5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.41 2.59A2 2 0 0016 2H9.83a2 2 0 00-1.42.59L2.59 8.41a2 2 0 000 2.83l6.17 6.17a2 2 0 002.83 0l5.82-5.82A2 2 0 0018 10.17V4a2 2 0 00-.59-1.41zM14 7a1 1 0 110-2 1 1 0 010 2z"></path>
                    </svg>
                    Featured Deals
                </h2>
                <a href="/business" class="text-xs font-bold text-emerald-400 transition-colors hover:text-emerald-300">View All<span class="hidden sm:inline"> Deals</span> -></a>
            </div>

            {% if latestBusinesses|length %}
                <div x-data="featuredDealsSlider()" x-init="init()" class="relative">
                    <div class="relative">
                        <div x-ref="track" @resize.window.debounce.150ms="measure()" class="flex touch-pan-x snap-x snap-proximity gap-2 overflow-x-auto overscroll-x-contain scroll-smooth pb-1 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:gap-3 md:gap-4 lg:gap-5">
                        {% for business in latestBusinesses %}
                            {% set businessImage = business.businessImages.one() %}
                            {% set currentMonthIndex = 'now'|date('n') - 1 %}
                            {% set currentMonthName = 'now'|date('F') %}
                            {% set currentSpecialRow = business.monthlySpecials[currentMonthIndex] ?? null %}
                            {% set currentSpecial = (currentSpecialRow and currentSpecialRow.special|length) ? currentSpecialRow.special : null %}
                            {% set businessCategories = business.category.all() %}
                            {% set valueTier = business.valueTier.value ?? '' %}
                            {% set valueBadge = null %}
                            {% if valueTier == 'coversMembership' %}
                                {% set valueBadge = { compact: 'Covers year', label: 'Pays for itself' } %}
                            {% elseif valueTier == 'doubleValue' %}
                                {% set valueBadge = { compact: '2× value', label: '2× value' } %}
                            {% elseif valueTier == 'fiveTimesValue' %}
                                {% set valueBadge = { compact: '5× value', label: '5× value' } %}
                            {% endif %}

                            <a href="{{ business.url }}" class="group w-[calc((100%_-_0.5rem)_/_2)] shrink-0 snap-start overflow-hidden rounded-md border border-white/10 bg-[#0b1726] shadow-[0_12px_26px_rgba(0,0,0,0.26),0_3px_8px_rgba(0,0,0,0.18),inset_0_1px_0_rgba(255,255,255,0.06)] transition-all hover:border-emerald-300/35 hover:bg-[#0f2033] hover:shadow-[0_16px_34px_rgba(0,0,0,0.3),0_4px_10px_rgba(0,0,0,0.2),0_0_0_1px_rgba(52,211,153,0.08)] sm:w-[44vw] md:w-[30vw] lg:w-[calc((100%_-_3.75rem)_/_4)]">
                                <div class="relative aspect-square bg-[#111f31] md:aspect-[1.48/1]">
                                    {% if businessImage %}
                                        {% if businessImage.optimizedImage %}
                                            {{ businessImage.optimizedImage.pictureTag().pictureAttrs({'class': 'block h-full w-full'}).imgAttrs({'alt': businessImage.title ?: business.title, 'class': 'h-full w-full object-cover'}).render() }}
                                        {% else %}
                                            <img src="{{ businessImage.url }}" alt="{{ businessImage.title ?: business.title }}" class="h-full w-full object-cover">
                                        {% endif %}
                                    {% else %}
                                        <div class="flex h-full w-full items-center justify-center bg-[#111f31] text-emerald-400">
                                            <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                            </svg>
                                        </div>
                                    {% endif %}
                                    {% if valueBadge %}
                                        <span aria-label="{{ valueBadge.label }}" class="absolute right-1 top-1 whitespace-nowrap rounded border border-white/50 bg-[#06101d]/95 px-2 py-1 text-sm font-semibold uppercase leading-none text-white shadow-lg sm:right-2 sm:top-2 sm:text-base lg:right-3 lg:top-3 lg:px-3 lg:py-1.5">
                                            <span class="lg:hidden">{{ valueBadge.compact }}</span>
                                            <span class="hidden lg:inline">{{ valueBadge.label }}</span>
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="p-2.5 lg:p-4">
                                    <h3 class="mb-1 truncate text-sm font-medium text-white lg:mb-0 lg:text-lg">{{ business.title }}</h3>
                                    {% if currentSpecial %}
                                        <p class="line-clamp-2 min-h-[2.5rem] text-base leading-tight text-emerald-300 lg:mt-2 lg:min-h-[3.6rem] lg:text-2xl lg:font-medium">{{ currentSpecial }}</p>
                                    {% else %}
                                        <p class="line-clamp-2 min-h-[2.5rem] text-base font-bold leading-tight text-emerald-300 lg:mt-2 lg:min-h-[3.6rem] lg:text-2xl lg:font-extrabold">Deal for {{ currentMonthName }}</p>
                                    {% endif %}
                                    <div class="mt-2 hidden items-center justify-between gap-2 lg:flex">
                                        {% if businessCategories|length %}
                                            <p class="truncate text-sm font-medium text-white/80">{{ businessCategories|map(c => c.title)|join(', ') }}</p>
                                        {% else %}
                                            <p class="truncate text-sm font-medium text-white/80">Local deal</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </a>
                        {% endfor %}
                        </div>

                        <button @click="previous()" :disabled="index === 0" type="button" aria-label="Previous featured deals" class="absolute inset-y-0 left-0 z-10 flex w-10 items-center justify-center rounded-l-md border-y border-l border-white/20 bg-[#06101d]/85 text-white shadow-lg shadow-black/30 transition-colors hover:border-emerald-300/45 hover:text-emerald-300 disabled:cursor-not-allowed disabled:opacity-35 sm:w-12 lg:w-14">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>

                        <button @click="next()" :disabled="index >= maxIndex" type="button" aria-label="Next featured deals" class="absolute inset-y-0 right-0 z-10 flex w-10 items-center justify-center rounded-r-md border-y border-r border-white/20 bg-[#06101d]/85 text-white shadow-lg shadow-black/30 transition-colors hover:border-emerald-300/45 hover:text-emerald-300 disabled:cursor-not-allowed disabled:opacity-35 sm:w-12 lg:w-14">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="mt-3 flex items-center justify-center gap-1.5">
                        <template x-for="page in pageCount" :key="page">
                            <button @click="goToPage(page - 1)" type="button" :aria-label="`Go to featured deals page ${page}`" class="h-2 rounded-full transition-all" :class="currentPage === page - 1 ? 'w-6 bg-emerald-400' : 'w-2 bg-white/30 hover:bg-white/50'"></button>
                        </template>
                    </div>
                </div>
            {% else %}
                <div class="rounded-md border border-white/10 bg-white/5 p-5 text-center text-sm text-white/70">No business listings available yet.</div>
            {% endif %}
            </div>
        </section>

        <section class="my-6 border-y border-white/10 bg-[#071321] px-5 py-10 sm:px-7 lg:my-10 lg:py-16">
            <div class="mx-auto grid w-full max-w-[90rem] gap-x-8 gap-y-12 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center lg:gap-x-14 lg:gap-y-0">
                <div class="max-w-3xl">
                    <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-emerald-400">How it works</p>
                    <h2 class="mt-2 text-2xl font-extrabold leading-tight text-white lg:text-3xl">Three simple steps. A year of local savings.</h2>
                    <p class="mt-4 text-base font-medium leading-7 text-white/80 lg:text-lg">
                        Find an offer worth using, join Gifts Around, then redeem it locally and keep saving throughout the year.
                    </p>
                    <div class="mt-5 grid gap-3 text-sm text-white/85 sm:grid-cols-3 lg:text-base">
                        <div class="rounded-md border border-white/10 bg-[#0b1726] p-4">
                            <span class="block text-xs font-extrabold uppercase tracking-wide text-emerald-400">1. Find a deal you’ll use</span>
                            <p class="mt-2 font-medium leading-6">Browse monthly offers from 100+ local businesses.</p>
                        </div>
                        <div class="rounded-md border border-white/10 bg-[#0b1726] p-4">
                            <span class="block text-xs font-extrabold uppercase tracking-wide text-emerald-400">2. Join for $9.99/year</span>
                            <p class="mt-2 font-medium leading-6">One qualifying deal may cover the entire membership.</p>
                        </div>
                        <div class="rounded-md border border-white/10 bg-[#0b1726] p-4">
                            <span class="block text-xs font-extrabold uppercase tracking-wide text-emerald-400">3. Show your membership</span>
                            <p class="mt-2 font-medium leading-6">Redeem the offer locally and keep saving all year.</p>
                        </div>
                    </div>
                </div>

                <div class="mx-auto w-full max-w-sm overflow-hidden rounded-md border border-white/10 bg-[#06101d] shadow-[0_18px_40px_rgba(0,0,0,0.32)] lg:mx-0 lg:justify-self-end" style="max-width: 420px; aspect-ratio: 9 / 16;">
                    <iframe src="https://www.youtube.com/embed/PvWG0OZNlG0" title="How Gifts Around works" class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                </div>
            </div>
        </section>

        <section class="bg-[#081522] px-5 pb-10 pt-5 sm:px-7 lg:pb-14 lg:pt-4">
            <div class="mx-auto w-full max-w-[90rem]">
            <div class="mb-10 rounded-md border border-white/10 bg-[#06101d] px-5 py-7 lg:px-8 lg:py-10">
                <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-emerald-400">Membership value</p>
                <h2 class="mt-2 text-2xl font-extrabold leading-tight text-white lg:text-3xl">A small annual price with room to save much more.</h2>
                <p class="mt-3 max-w-3xl text-base font-medium leading-7 text-white/75 lg:text-lg">Membership costs $9.99. Many individual deals can cover that cost on their own, with more offers waiting throughout the year.</p>

                <div class="mt-6 grid gap-3 sm:grid-cols-3">
                    <div class="rounded-md border border-white/10 bg-[#0b1726] p-4 text-center">
                        <svg class="mx-auto mb-3 h-9 w-9 text-emerald-400 lg:h-11 lg:w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.7 0-3 .9-3 2s1.3 2 3 2 3 .9 3 2-1.3 2-3 2m0-8V6m0 12v-2m9-4a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-sm font-bold leading-snug text-white lg:text-base">One useful deal could cover your $9.99 membership.</p>
                    </div>
                    <div class="rounded-md border border-white/10 bg-[#0b1726] p-4 text-center">
                        <svg class="mx-auto mb-3 h-9 w-9 text-emerald-400 lg:h-11 lg:w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20v-2a4 4 0 00-4-4h-2a4 4 0 00-4 4v2M12 10a4 4 0 100-8 4 4 0 000 8zM20 20v-2a3 3 0 00-2-2.8M4 20v-2a3 3 0 012-2.8"></path>
                        </svg>
                        <p class="text-sm font-bold leading-snug text-white lg:text-base">Monthly savings at 100+ local businesses.</p>
                    </div>
                    <div class="rounded-md border border-white/10 bg-[#0b1726] p-4 text-center">
                        <svg class="mx-auto mb-3 h-9 w-9 text-emerald-400 lg:h-11 lg:w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 2v3m8-3v3M3 9h18M5 4h14a2 2 0 012 2v14H3V6a2 2 0 012-2zM7 13h3m4 0h3m-10 4h3m4 0h3"></path>
                        </svg>
                        <p class="text-sm font-bold leading-snug text-white lg:text-base">New offers every month, all year long.</p>
                    </div>
                </div>
            </div>

            <div id="categories">
                <h2 class="mb-3 text-xl font-extrabold text-white lg:text-2xl">Browse by Category</h2>
                <div class="flex flex-wrap justify-center gap-1.5 lg:gap-2">
                    {% for category in categories %}
                        <a href="{{ category.url }}" class="flex aspect-square min-h-[48px] flex-1 basis-[31%] flex-col items-center justify-center rounded-md border border-white/10 bg-[#06101d] px-1.5 text-center transition-colors hover:border-emerald-400/60 hover:bg-white/5 lg:min-h-[76px] lg:basis-[15%]">
                            {% if category.icon == 'food' %}
                                <svg class="mb-1 h-7 w-7 text-emerald-400 lg:mb-3 lg:h-10 lg:w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4h14l-7 8-7-8zM12 12v7M8.5 20h7"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 7h6"></path>
                                </svg>
                            {% elseif category.icon == 'retail' %}
                                <svg class="mb-1 h-7 w-7 text-emerald-400 lg:mb-3 lg:h-10 lg:w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V8a4 4 0 00-8 0v3M5 9h14l1 12H4L5 9z"></path>
                                </svg>
                            {% elseif category.icon == 'ticket' %}
                                <svg class="mb-1 h-7 w-7 text-emerald-400 lg:mb-3 lg:h-10 lg:w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 8.5V6a2 2 0 012-2h12a2 2 0 012 2v2.5a3.5 3.5 0 000 7V18a2 2 0 01-2 2H6a2 2 0 01-2-2v-2.5a3.5 3.5 0 000-7zM9 12h6"></path>
                                </svg>
                            {% elseif category.icon == 'heart' %}
                                <svg class="mb-1 h-7 w-7 text-emerald-400 lg:mb-3 lg:h-10 lg:w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 00-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-3-3v6"></path>
                                </svg>
                            {% elseif category.icon == 'car' %}
                                <svg class="mb-1 h-7 w-7 text-emerald-400 lg:mb-3 lg:h-10 lg:w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 13l1.7-4.2A2 2 0 018.55 7h6.9a2 2 0 011.86 1.26L19 13"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 13h16v5H4v-5zM7 18v1.5M17 18v1.5M7.5 15.5h.01M16.5 15.5h.01"></path>
                                </svg>
                            {% else %}
                                <svg class="mb-1 h-8 w-8 text-emerald-400 lg:mb-3 lg:h-12 lg:w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.3 4.3c.4-1.7 2.9-1.7 3.4 0a1.7 1.7 0 002.5 1c1.5-.9 3.3.8 2.4 2.4a1.7 1.7 0 001 2.5c1.7.4 1.7 2.9 0 3.4a1.7 1.7 0 00-1 2.5c.9 1.5-.8 3.3-2.4 2.4a1.7 1.7 0 00-2.5 1c-.4 1.7-2.9 1.7-3.4 0a1.7 1.7 0 00-2.5-1c-1.5.9-3.3-.8-2.4-2.4a1.7 1.7 0 00-1-2.5c-1.7-.4-1.7-2.9 0-3.4a1.7 1.7 0 001-2.5c-.9-1.5.8-3.3 2.4-2.4a1.7 1.7 0 002.5-1z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                            {% endif %}
                            <span class="text-[0.64rem] font-bold leading-tight text-white lg:text-sm">{{ category.fullTitle }}</span>
                        </a>
                    {% endfor %}
                </div>

                <div class="mt-5 rounded-md border border-white/10 bg-[#0a1828] p-5 lg:flex lg:min-h-[194px] lg:items-center lg:justify-between">
                    <div>
                        <h2 class="text-xl font-extrabold text-white lg:text-2xl">Own a Business?</h2>
                        <p class="mt-2 max-w-xs text-sm font-medium leading-5 text-white lg:text-base">List your specials FREE and reach more local customers.</p>
                        <a href="/business/signup" class="mt-5 inline-flex h-11 items-center justify-center rounded-md bg-blue-600 px-7 text-sm font-semibold text-white transition-colors hover:bg-blue-500">
                            List My Business
